# Demo behavior
EASTCO_DRY_RUN=true
EASTCO_DATASET_DIR=data/documents
EASTCO_GROUND_TRUTH=data/ground_truth.jsonl
EASTCO_PRICING_CONFIG=pricing.example.json
EASTCO_RESULTS_DIR=results
EASTCO_MAX_RETRIES=2
