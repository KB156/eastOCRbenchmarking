BENCHMARK_MODE=dry
INPUT_ZIP=/REPLACE_WITH_PATH/SampleData.zip
GEMINI_API_KEY=REPLACE_WITH_AI_STUDIO_KEY
GEMINI_VLM_MODEL=gemini-3.8-flash
GEMINI_LLM_MODEL=gemini-3.8-flash
PADDLE_OCR_URL=https://REPLACE_WITH_OCR_SERVICE.run.app
PADDLE_VL_URL=https://REPLACE_WITH_VL_SERVICE.run.app
# Empty tokens use Google application default credentials to obtain ID tokens.
PADDLE_OCR_TOKEN=
PADDLE_VL_TOKEN=
MAX_RETRIES=2
REQUEST_TIMEOUT=180
HYBRID_THRESHOLD=1.0
VERIFIED_DATES=20260801
PRICING_FILE=pricing.live.json
RESULTS_DIR=results

# Web console. A password of at least 16 characters is required on non-loopback hosts.
WEB_HOST=127.0.0.1
PORT=8765
WEB_PASSWORD=
WEB_SECURE_COOKIE=false

# Your contract rates in one currency. Blank is unknown, explicit 0 means no charge.
COST_CURRENCY=USD
VLM_INPUT_PER_MILLION=
VLM_OUTPUT_PER_MILLION=
LLM_INPUT_PER_MILLION=
LLM_OUTPUT_PER_MILLION=
# Combined allocated CPU/RAM/GPU active cost per inference second; not list prices.
OCR_ACTIVE_PER_SECOND=
VL_ACTIVE_PER_SECOND=
# Allocated overhead for the entire benchmark run, excluding active compute above.
IDLE_COST=
STORAGE_COST=
NETWORK_COST=
LOGGING_COST=
BUILD_COST=
OTHER_COST=
TAX_COST=

# Optional billing reconciliation. Include Gemini, OCR and web-app billed projects.
BILLING_QUERY_PROJECT=
BILLING_TABLE=
BILLING_PROJECT_IDS=
BILLING_LOCATION=US
# Empty token uses the server's application default credentials. Never paste keys in chat.
BILLING_ACCESS_TOKEN=
BILLING_SCOPE=shared
BILLING_ALLOCATION_FRACTION=
# Optional timezone-aware ISO timestamps; blank uses the benchmark start/end.
BILLING_START=
BILLING_END=
BILLING_MAX_BYTES=1000000000
BILLING_AUTO_REFRESH=false
